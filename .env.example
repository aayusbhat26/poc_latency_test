# Copy to .env and fill in. The Kafka components fall back to generated data
# when KAFKA_BOOTSTRAP_SERVERS is missing, so only HF_TOKEN is strictly required.

# Aiven Kafka service URI, for example "host:port".
KAFKA_BOOTSTRAP_SERVERS=<YOUR_AIVEN_SERVICE_URI>

# Topic used by the producer and both consumers.
KAFKA_TOPIC=hvac_telemetry

# TLS material for the Aiven service. Files sit in the repository root.
KAFKA_SSL_CA_LOCATION=ca.pem
KAFKA_SSL_CERT_LOCATION=service.cert
KAFKA_SSL_KEY_LOCATION=service.key

# Hugging Face token used to upload and download the generated lake.
HF_TOKEN=
